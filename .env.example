APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Set true temporarily while commissioning to log every App\Jobs lifecycle.
# Retries and final failures are always logged.
PIPELINE_LOG_QUEUE_LIFECYCLE=false
# Set true temporarily to record why individual discovered articles were skipped.
PIPELINE_LOG_CANDIDATE_SKIPS=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the 900-second video worker timeout. Otherwise a video job can
# be released and run a second time while the first worker is still active.
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Media pipeline (see docs/MEDIA_ARCHITECTURE.md) ---
# Production: QUEUE_CONNECTION=redis, CACHE_STORE=redis, REDIS_CLIENT=predis
MEDIA_DISK=s3
MEDIA_MAX_IMAGE_BYTES=15728640
MEDIA_MAX_VIDEO_BYTES=209715200
MEDIA_MAX_DOCUMENT_BYTES=26214400
MEDIA_EMBEDDING_DEDUP_ENABLED=false
# Selection-time image fingerprinting: the only dedup level that can tell one
# photograph published under two unrelated filenames from two photographs.
# Bytes are hashed in memory and dropped, never stored. Raising the candidate
# count or the budget trades selection latency for a wider comparison.
MEDIA_FINGERPRINT_MAX_BYTES=8388608
MEDIA_FINGERPRINT_CANDIDATES=8
MEDIA_FINGERPRINT_TIMEOUT_SECONDS=8
MEDIA_FINGERPRINT_BUDGET_SECONDS=25
# Optional global override for the clear server-side default
# `imvnn-news-fetcher/1.0`. Prefer a source-specific `fetch_options.headers`
# override in config/news_sources.php when only one upstream needs it.
# HTTP_FETCH_USER_AGENT="imvnn-news-fetcher/1.0"
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URI=https://api.telegram.org
# Channel to publish into, used by `php artisan db:seed --class=TelegramChannelSeeder`.
# Either an @username or a numeric chat id. `php artisan telegram:channel @name`
# does the same thing interactively and verifies the bot can actually post.
TELEGRAM_CHANNEL_CHAT_ID=
TELEGRAM_CHANNEL_NAME=

# --- AI provider: Gemini default or an OpenAI-compatible hosted/local API ---
# Supported: gemini | openai-compatible
AI_PROVIDER=gemini
# Leave empty only for a trusted local OpenAI-compatible server with no auth.
AI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite
AI_BASE_URI=https://generativelanguage.googleapis.com
# For openai-compatible, set AI_BASE_URI to its server and adjust as needed:
# e.g. http://127.0.0.1:8000/v1 with AI_OPENAI_PATH=chat/completions
# Use json_object or none when the server does not support JSON Schema output.
AI_OPENAI_PATH=chat/completions
AI_OPENAI_STRUCTURED_OUTPUT=json_schema
AI_OPENAI_MAX_TOKENS_FIELD=max_tokens

# Article analysis. Leave AI_API_KEY empty to use the free heuristic parser.
AI_ANALYSIS_ENABLED=true
AI_ANALYSIS_MAX_OUTPUT_TOKENS=500
AI_ANALYSIS_MAX_INPUT_CHARS=12000
AI_ANALYSIS_TIMEOUT_SECONDS=20

# Telegram captions: strictly Uzbek, simple language; the application always
# appends a direct source link and normalizes hashtags to lowercase.
# Leave AI_CAPTION_ENABLED=false (or AI_API_KEY empty) to fall back
# to a plain title+excerpt caption in the article's original language.
AI_CAPTION_ENABLED=true
AI_CAPTION_MAX_OUTPUT_TOKENS=400
AI_CAPTION_MAX_INPUT_CHARS=4000
AI_CAPTION_TIMEOUT_SECONDS=20

# Poll sources every five minutes by default so fresh stories are discovered
# near publication time. Raise only when upstream rate limits require it.
NEWS_FETCH_INTERVAL_MINUTES=5

# --- Topic and freshness policy ------------------------------------------
# Restrict ingestion to AI, machine learning and robotics. Applies to both
# the keyword prefilter and the model's own relevance verdict; set false to
# take whatever the sources publish (useful while bringing a channel up).
NEWS_TOPIC_FILTER_ENABLED=true

# Rolling freshness lookback in hours. Takes precedence over the calendar-day
# policy below when set. Leave empty in production so only the current day's
# news is ever published; set it (e.g. 72) in development, where only-today
# leaves too few candidates to exercise the pipeline.
NEWS_MAX_AGE_HOURS=

# Calendar-day freshness, in the audience's timezone.
NEWS_ONLY_TODAY=true
NEWS_DAY_TIMEZONE=Asia/Tashkent
NEWS_STORAGE_TIMEZONE=UTC

# Timezone every timestamp is STORED in. Keep it equal to NEWS_DAY_TIMEZONE.
# Only safe for a zone without daylight saving; see config/app.php.
APP_TIMEZONE=Asia/Tashkent

# How often sources are polled.
NEWS_FETCH_INTERVAL_MINUTES=5

# When the AI provider cannot write a caption, post the article's own words
# (usually English) rather than not posting. Off by default: on a channel that
# publishes in a specific language, staying silent beats posting untranslated.
TELEGRAM_CAPTION_FALLBACK_ORIGINAL=false
